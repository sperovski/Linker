server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Same-origin API: the prod frontend calls /api and nginx forwards to the
    # API service, so no CORS is involved. API_ORIGIN is substituted by the
    # nginx image's envsubst at container start (compose: http://api:8080,
    # Fly.io: http://linker-api.internal:8080).
    #
    # The upstream sits in a variable on purpose: with a literal proxy_pass,
    # nginx resolves the hostname once at config load and exits permanently if
    # DNS isn't ready yet (a startup-ordering crash we actually hit). Via a
    # variable + resolver it re-resolves per request and just 502s until the
    # API appears. NGINX_RESOLVER: Docker's embedded DNS by default, Fly's
    # internal resolver ([fdaa::3]) via fly.toml.
    resolver ${NGINX_RESOLVER} valid=30s;
    location /api/ {
        # $request_uri is the full original URI (starts with /api/), so the
        # upstream sees the same path the browser sent — same mapping as the
        # old literal "proxy_pass ${API_ORIGIN}/api/".
        set $api_origin ${API_ORIGIN};
        proxy_pass $api_origin$request_uri;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 10m;
    }

    # SignalR chat hub. WebSockets need the Upgrade/Connection headers passed
    # through and no buffering; without this location the /hubs path would fall
    # through to the SPA catch-all and the socket would never connect.
    location /hubs/ {
        set $api_origin ${API_ORIGIN};
        proxy_pass $api_origin$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_read_timeout 1h;
    }

    # SPA fallback: unknown paths render index.html and Angular routes them.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # index.html must always be revalidated. It is the only file naming the
    # hashed asset bundles, and those are served immutable below — so a browser
    # allowed to cache this HTML keeps pointing at a previous build's CSS/JS and
    # never sees a deploy. (Without an explicit header nginx sends none, and
    # browsers then cache HTML heuristically, which is exactly this bug.)
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Angular's own build output only: main-<hash>.js, chunk-<hash>.js,
    # styles-<hash>.css. The hash changes whenever the content does, so a long
    # immutable TTL is safe here — a new build is always a new URL.
    location ~* ^/(main|polyfills|chunk|styles)-[A-Za-z0-9_-]+\.(js|css)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Plain files copied as-is from public/ (logo, favicon, decorative icons)
    # keep their ORIGINAL filename forever — replacing one (as we did with the
    # logo) is a same-URL content change. "immutable" specifically tells the
    # browser never to revalidate even on a manual hard refresh, so a prior
    # immutable response here meant the new logo was invisible no matter what
    # the user did on their end. Short cache + revalidation instead: fast on
    # repeat loads, but nginx's automatic ETag/Last-Modified makes that
    # revalidation a cheap 304, and a real update is picked up within minutes.
    location ~* \.(png|jpg|jpeg|svg|woff2?|ico)$ {
        expires 5m;
        add_header Cache-Control "public, must-revalidate";
    }
}
