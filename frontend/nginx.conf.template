server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Same-origin API: the prod frontend calls /api and nginx forwards to the
    # API service, so no CORS is involved. API_ORIGIN is substituted by the
    # nginx image's envsubst at container start (compose: http://api:8080,
    # Fly.io: http://linker-api.internal:8080).
    location /api/ {
        proxy_pass ${API_ORIGIN}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        client_max_body_size 10m;
    }

    # SPA fallback: unknown paths render index.html and Angular routes them.
    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(js|css|png|jpg|jpeg|svg|woff2?)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }
}
